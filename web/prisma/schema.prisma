// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("SPELLBOOK_DATABASE_URL")
  schemas  = ["spellbook"]
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
  @@schema("spellbook")
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
  @@schema("spellbook")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("spellbook")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("staff") // "admin" | "staff"
  active        Boolean   @default(true) // false = archivált (nem léphet be, nem választható új munkához)
  archivedAt    DateTime?
  priceListType String    @default("beginner") // "master" | "beginner" — melyik árlistán dolgozik

  // Google Naptár — dolgozónként külön fiók. A refresh token hosszú életű
  // hozzáférés, ezért csak a szervezen olvassuk, a kliens sosem látja.
  googleRefreshToken String?
  googleCalendarId   String? // melyik naptár; üresen a "primary"
  googleEmail        String? // melyik fiókkal kötötte össze — ez látszik a UI-on
  googleConnectedAt  DateTime?

  /// Lehet-e hozzá online időpontot kérni. Alapból NEM: így egy emberrel
  /// lehet élesben kipróbálni, mielőtt mindenki bekerül.
  onlineBookable Boolean @default(false)

  /// Ide megy értesítés a hozzá érkező foglalási kérésről. NEM a belépési cím:
  /// az egy kitalált @salon-spellbook.local, oda nem érkezik levél. Üresen
  /// hagyva a dolgozó csak a Spellbookban látja a kérést.
  notifyEmail        String?
  accounts           Account[]
  sessions           Session[]
  posts              Post[]
  financeEntries     FinanceEntry[]
  workDays           WorkDay[]
  serviceCategories  ServiceCategory[]
  services           Service[]
  guestCards         GuestCard[]
  appointments       Appointment[]
  timeOff            TimeOff[]
  bookableWindows    BookableWindow[]
  ignoredEventTitles IgnoredEventTitle[]
  bookings           Booking[]
  expenses           Expense[]           @relation("ExpenseCreatedBy")
  assignedExpenses   Expense[]           @relation("ExpenseAssignedTo")
  recurringExpenses         RecurringExpense[] @relation("RecurringCreatedBy")
  assignedRecurringExpenses RecurringExpense[] @relation("RecurringAssignedTo")

  @@schema("spellbook")
}

/// A szalon egyetlen beállítás-sora. Azért tábla és nem env-változó: ezeket a
/// szalon állítja magának a felületen, nem fejlesztéskor dőlnek el.
///
/// A tábla egy korábbi, szalon-szintű Google-összekötésből maradt (a tokenek
/// ma dolgozónként vannak, a `User`-en). A régi oszlopok az adatbázisban
/// megmaradtak, de itt nem szerepelnek — nincs rájuk szükség.
model SalonSetting {
  /// Mindig "default" — egy sor van belőle.
  id String @id @default("default")

  /// Meddig lehet előre időpontot kérni. Üresen a `bookingHorizonDays` dönt.
  /// Ezzel megy a "havonta nyitjuk a következő hónapot".
  bookingOpenUntil   DateTime?
  /// Ennél közelebbi időpontra már nem lehet online kérni.
  bookingLeadHours   Int       @default(12)
  /// Meddig lát előre a vendég, ha nincs kézi nyitási dátum.
  bookingHorizonDays Int       @default(60)

  updatedAt DateTime @updatedAt

  @@schema("spellbook")
}

model WorkDay {
  id           String           @id @default(cuid())
  date         DateTime         @db.Date
  user         User             @relation(fields: [userId], references: [id])
  userId       String
  earnings     Float            @default(0)
  notes        String?
  startTime    String? // érkezés "HH:MM"
  endTime      String? // távozás "HH:MM"
  financeEntry FinanceEntry?
  services     WorkDayService[]

  // A munkaidőhöz kiküldött Google-esemény — hogy módosításkor ne új jöjjön létre.
  googleEventId String?

  @@unique([date, userId])
  @@index([date])
  @@schema("spellbook")
}

model WorkDayService {
  id        String  @id @default(cuid())
  workDay   WorkDay @relation(fields: [workDayId], references: [id], onDelete: Cascade)
  workDayId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String
  quantity  Int     @default(1)
  priceSnap Float // ár a bejegyzés pillanatában

  @@unique([workDayId, serviceId])
  @@schema("spellbook")
}

model FinanceEntry {
  id           String     @id @default(cuid())
  type         String // "revenue" | "material" | "wage"
  description  String
  amount       Float
  date         DateTime   @default(now())
  createdAt    DateTime   @default(now())
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdById  String
  workDay      WorkDay?   @relation(fields: [workDayId], references: [id], onDelete: Cascade)
  workDayId    String?    @unique
  guestCard    GuestCard? @relation(fields: [guestCardId], references: [id], onDelete: SetNull)
  guestCardId  String?
  visitGroupId String?

  @@index([date])
  @@index([type])
  @@index([visitGroupId])
  @@schema("spellbook")
}

model Guest {
  id        String      @id @default(cuid())
  name      String
  phone     String?
  /// Online foglalásból kerül ide. A levelezéshez kell; a foglalás lemondása
  /// után is megmarad, ezért a törlési kérésnél is számít.
  email     String?
  notes     String?
  createdAt DateTime    @default(now())
  cards     GuestCard[]

  // GDPR — a vendéget tájékoztattuk az adatkezelésről (6. cikk (1) b) + a
  // jegyzetbe kerülő egészségi adatokhoz (9. cikk (2) a) hozzájárult.
  consentAt     DateTime?
  consentSource String? // "szóban" | "papíron" | "online"

  appointments Appointment[]
  bookings     Booking[]

  @@index([name])
  @@schema("spellbook")
}

// GDPR elszámoltathatóság (5. cikk (2)): ki, mikor, milyen érintetti kérést
// teljesített. Szándékosan nem hivatkozik a Guest-re, hogy a vendég törlése
// után is megmaradjon a bizonyíték a törlés megtörténtéről.
model GdprLog {
  id         String   @id @default(cuid())
  action     String // "export" | "delete" | "retention" | "consent"
  subject    String // a vendég neve a művelet pillanatában
  subjectId  String? // a vendég id-ja (törlés után már nem létezik)
  detail     String?
  actorId    String? // melyik felhasználó végezte
  actorEmail String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@schema("spellbook")
}

// Kiállított bizonylat (nyugta vagy számla). A bizonylatot a Számlázz.hu állítja
// ki és ő végzi a NAV-adatszolgáltatást is — nálunk csak a hivatkozás marad,
// hogy a vendégkártyáról vissza lehessen keresni. A PDF-et szándékosan NEM
// tároljuk: bármikor letölthető a bizonylatszám alapján.
model Receipt {
  id     String     @id @default(cuid())
  card   GuestCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  cardId String?
  kind   String // "nyugta" | "szamla"
  number String     @unique // nyugtaszám / számlaszám

  // Melyik szolgáltató állította ki: "szamlazz" | "billingo". A szolgáltató
  // cserélhető, de egy régi bizonylat sztornója és PDF-je csak ott érhető el,
  // ahol készült — ezért kell megjegyezni.
  provider      String  @default("szamlazz")
  externalId    String? // a szolgáltató belső azonosítója (Billingónál kell)
  total         Float
  paymentMethod String // "készpénz" | "bankkártya" | "átutalás"

  // Csak számlánál — az Áfa tv. 169. §-a szerint kötelező vevőadatok
  buyerName    String?
  buyerZip     String?
  buyerCity    String?
  buyerAddress String?
  buyerEmail   String?

  // Sztornó: a sztornó bizonylat száma és ideje az eredeti soron marad
  stornoNumber String?
  stornoedAt   DateTime?

  issuedAt     DateTime @default(now())
  issuedById   String?
  issuedByName String?

  @@index([cardId])
  @@index([issuedAt])
  @@schema("spellbook")
}

/// Előjegyzés: egy jövőbeli vendég-időpont.
///
/// A Spellbook naptára eredetileg visszatekintő volt (munkanap, bevétel,
/// vendégkártya), az időpontok pedig a Google Naptárból jöttek. Ez a modell teszi
/// az appot foglalásra is alkalmassá — és ami itt készül, az kimegy a dolgozó
/// Google Naptárába, hogy továbbra is egy helyen legyen minden.
model Appointment {
  id    String   @id @default(cuid())
  start DateTime
  end   DateTime

  worker   User   @relation(fields: [workerId], references: [id])
  workerId String

  // A vendég lehet ismert (kartotékos) vagy csak egy név — egy telefonos
  // érdeklődőt nem akarunk kényszerből felvenni a vendégkönyvbe.
  guest     Guest?  @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestId   String?
  guestName String
  phone     String?

  /// A tervezett szolgáltatások neve, vesszővel — csak tájékoztató.
  /// A tényleges elszámolás a vendégkártyán történik.
  services String?
  notes    String?

  status String @default("foglalt") // "foglalt" | "lemondott"

  /// A hozzá tartozó Google-esemény, hogy módosításkor ne új jöjjön létre,
  /// és hogy a Google-ből visszaolvasva ne jelenjen meg kétszer.
  googleEventId String? @unique

  /// Ha már megérkezett és készült róla vendégkártya.
  cardId String?

  createdAt   DateTime @default(now())
  createdById String?

  @@index([start])
  @@index([workerId])
  @@schema("spellbook")
}

/// Nem foglalható időszak: szabadság, zárva tartás, betegség.
///
/// Egy nap egy sor. Ha `workerId` üres, az egész szalonra vonatkozik (pl. ünnep),
/// egyébként csak arra a dolgozóra. A szabad idő számítása ezeket kihagyja, így
/// ide nem lehet se kézzel, se később online időpontot foglalni.
model TimeOff {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  worker    User?    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String?
  reason    String?
  createdAt DateTime @default(now())

  @@unique([date, workerId])
  @@index([date])
  @@schema("spellbook")
}

/// Online foglalható idősáv.
///
/// A munkaidő a belső nyilvántartás: mikor van bent a dolgozó. Ez viszont azt
/// mondja meg, mennyit adunk ki ebből a nyilvános foglalónak — a maradék marad
/// beugró vendégnek, konzultációnak, szünetnek.
///
/// Egy naphoz és dolgozóhoz több sáv is tartozhat (pl. délelőtt és késő délután).
model BookableWindow {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  worker    User     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  startTime String // "HH:MM"
  endTime   String // "HH:MM"

  /// Mire adjuk ki ezt a sávot. Mindkettő üresen: bármire lehet rá időpontot
  /// kérni. Kategória és egyedi tétel egyszerre is megadható — a délelőtt mehet
  /// "Férfi hajvágás" egészben, a délután meg két kiválasztott festésre.
  ///
  /// Azért id-listák és nem kapcsolótábla: a sáv rövid életű (egy napra szól),
  /// tucatszám keletkezik a havi nyitáskor, és sosem kérdezünk rá visszafelé,
  /// hogy "melyik sávokban szerepel ez a szolgáltatás".
  categoryIds String[] @default([])
  serviceIds  String[] @default([])

  createdAt DateTime @default(now())

  @@index([date])
  @@index([workerId, date])
  @@schema("spellbook")
}

/// Naptárcím, ami nem vendég: másik munkahely, saját elfoglaltság, szünet.
///
/// A "korábbi időpont bejegyzés nélkül" figyelmeztetés ezeket kihagyja —
/// különben a másik munkahely minden napja hiányzó bejegyzésnek látszana.
/// A `workerId` üresen az egész szalonra vonatkozik.
model IgnoredEventTitle {
  id        String   @id @default(cuid())
  pattern   String // a cím egy részlete, kis/nagybetűre és ékezetre érzéketlenül
  worker    User?    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String?
  createdAt DateTime @default(now())

  @@index([workerId])
  @@schema("spellbook")
}

/// Beérkezett foglalási kérés a nyilvános foglalóoldalról.
///
/// Szándékosan NEM vendég: a kérésből csak jóváhagyáskor lesz `Guest`. Így egy
/// robot vagy egy meggondolatlan látogató nem szemeteli tele a receptkönyvet
/// idegen nevekkel, és a meg nem valósult kérések gyorsan törölhetők.
model Booking {
  id    String @id @default(cuid())
  /// Kitalálhatatlan azonosító: ezzel nyílik a vendég saját oldala és a lemondás.
  token String @unique

  name  String
  email String
  phone String
  /// Szabad szöveg a vendégtől. Egészségi adat ide NEM kerülhet — a foglalóoldal
  /// ezt ki is írja.
  note  String?

  worker   User   @relation(fields: [workerId], references: [id])
  workerId String
  /// A kért szolgáltatás neve és hossza a kérés pillanatában, hogy egy későbbi
  /// árlista-módosítás ne írja át visszamenőleg, mit kért a vendég.
  service  String
  minutes  Int

  startsAt DateTime
  endsAt   DateTime

  /// kert | megerosites_varo | elfogadva | elutasitva | lemondva
  status      String    @default("megerosites_varo")
  /// Az e-mailes megerősítés ideje. Enélkül a kérés nem foglal helyet.
  confirmedAt DateTime?
  /// Mikor ment ki az emlékeztető. Enélkül egy újrafutó napi feladat
  /// többször is elküldené ugyanazt.
  remindedAt  DateTime?

  /// Csak elfogadáskor töltődik ki.
  guest         Guest?  @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestId       String?
  /// A dolgozó naptárába kiírt esemény.
  googleEventId String?

  /// Két kolléga egy látogatásban: a párban kért foglalások közös jele.
  /// Külön sor mindkettő, mert külön naptárba megy és külön bírálják el.
  groupId   String?

  /// Visszaélés-szűréshez: honnan érkezett a kérés.
  ip        String?
  createdAt DateTime @default(now())

  @@index([startsAt])
  @@index([status])
  @@index([email])
  @@index([groupId])
  @@schema("spellbook")
}

model GuestCard {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId   String
  worker    User     @relation(fields: [workerId], references: [id])
  workerId  String
  total     Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())

  // Melyik Google-időpontból készült — hogy ugyanabból ne legyen két kártya.
  googleEventId String? @unique

  services       GuestCardService[]
  materials      GuestCardMaterial[]
  financeEntries FinanceEntry[]
  receipts       Receipt[]

  @@index([guestId])
  @@index([date])
  @@schema("spellbook")
}

model GuestCardService {
  id           String    @id @default(cuid())
  card         GuestCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId       String
  name         String
  price        Float
  duration     Int       @default(0)
  gender       String?
  categoryName String?

  @@schema("spellbook")
}

model GuestCardMaterial {
  id        String    @id @default(cuid())
  card      GuestCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  name      String
  brand     String?
  colorCode String?
  grams     Float
  unitPrice Float
  lineTotal Float

  @@schema("spellbook")
}

model Material {
  id        String   @id @default(cuid())
  name      String
  price     Float
  unit      String? // pl. "adag", "tubus", "csomag"
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  /// Melyik árlistához tartozik — ugyanúgy, mint a szolgáltatás-kategóriák.
  /// A kozmetikusnak a szőkítőpor és a festék nem mond semmit, ezért mindenki
  /// csak a saját anyagait látja, és a magáét veszi fel.
  priceListType String @default("master")

  @@index([name])
  @@schema("spellbook")
}

// A színreceptben választható márkák. Eddig szabad szöveg volt, és ugyanaz a
// márka háromféleképpen szerepelt (Echos / echosline / Ecoshline) — a
// statisztika és a készlet nem tudta összevonni.
model MaterialBrand {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@schema("spellbook")
}

model Expense {
  id           String   @id @default(cuid())
  title        String
  amount       Float
  date         DateTime @db.Date
  category     String   @default("egyéb")
  /// "expense" | "income" — a bevétel itt a szolgáltatáson kívüli pénz (pl.
  /// székbérlet). Azért nem FinanceEntry, mert abból bért és szolgáltatási
  /// statisztikát számolunk; ez csak a szalon nyereségébe számít bele.
  kind         String   @default("expense")
  notes        String?
  paid         Boolean  @default(true)
  createdAt    DateTime @default(now())
  createdBy    User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdById  String
  assignedTo   User?    @relation("ExpenseAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?
  /// Melyik havi sablonból jött létre. A sablon törlése után a kiadás megmarad.
  recurring    RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  recurringId  String?

  @@unique([recurringId, date])
  @@index([date])
  @@index([assignedToId])
  @@schema("spellbook")
}

// Havonta ismétlődő kiadás (bérleti díj, könyvelés, járulék…) vagy bevétel (székbérlet). Minden hónapban
// létrehoz egy "függőben" kiadást a megadott napon — azért nem fizetettet, mert
// az összeg változhat (járulék), és így látszik, mit kell még kifizetni.
//
// A `nextDue` a következő még létre nem hozott nap. Csak előre lép, ezért ha a
// felhasználó kitöröl egy havi példányt, az nem jön vissza.
model RecurringExpense {
  id           String   @id @default(cuid())
  title        String
  amount       Float
  category     String   @default("Egyéb")
  kind         String   @default("expense") // "expense" | "income"
  notes        String?
  /// A hónap hányadik napján esedékes (1–31); rövidebb hónapban az utolsó nap.
  dayOfMonth   Int
  nextDue      DateTime @db.Date
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  createdBy    User     @relation("RecurringCreatedBy", fields: [createdById], references: [id])
  createdById  String
  assignedTo   User?    @relation("RecurringAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?
  expenses     Expense[]

  @@schema("spellbook")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("spellbook")
}

model ServiceCategory {
  id            String    @id @default(cuid())
  name          String
  order         Int       @default(0)
  priceListType String    @default("master")
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  services      Service[]

  @@index([userId])
  @@index([priceListType])
  @@schema("spellbook")
}

model Service {
  id          String           @id @default(cuid())
  name        String
  price       Float
  duration    Int              @default(30)
  description String?
  active      Boolean          @default(true)
  perHour     Boolean          @default(false) // true = óradíj, a listában/PDF-ben "Ft/óra"
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  category    ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  user        User             @relation(fields: [userId], references: [id])
  userId      String
  workDays    WorkDayService[]

  @@index([categoryId])
  @@index([userId])
  @@schema("spellbook")
}
