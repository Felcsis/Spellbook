# Next Auth
AUTH_SECRET="generate-with: npx auth secret"

# Prisma / PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/salon_spellbook"

# GDPR — az adatkezelő adatai. Ezek jelennek meg a /adatkezeles oldalon és a
# vendégeknek kiadott adatexport fejlécében. Ha üresen hagyod, az oldalon
# [szögletes zárójeles] helyőrzők látszanak — élesben ezeket ki KELL tölteni.
GDPR_CONTROLLER_NAME="Salon Spellbook"
GDPR_CONTROLLER_LEGAL="Minta Anna e.v."
GDPR_CONTROLLER_ADDRESS="6720 Szeged, Példa utca 1."
GDPR_CONTROLLER_REGNO="12345678-1-06"
GDPR_CONTROLLER_EMAIL="info@example.hu"
GDPR_CONTROLLER_PHONE="+36 30 123 4567"

# Számlázz.hu Számla Agent — nyugta és számla kiállítása a vendégkártyáról.
# A NAV felé kötelező nyugta-adatszolgáltatást a Számlázz.hu végzi helyettünk,
# de ehhez a fiókot össze kell kötni a NAV-val (technikai felhasználó +
# "nyugtaadat-szolgáltatási interfészhez jogosultság").
# Kulcs nélkül a bizonylat-funkció el van rejtve az appban.
SZAMLAZZ_AGENT_KEY=""
# A nyugtának és a számlának KÜLÖN előtagja van (Beállítások → Előtagok a Számlázz.hu-ban).
SZAMLAZZ_PREFIX_NYUGTA="P"
SZAMLAZZ_PREFIX_SZAMLA="PF"

# Számlázó szolgáltató: "billingo" vagy "szamlazz". Üresen azt használjuk,
# amelyikhez van kulcs. A már kiállított bizonylatok az eredeti szolgáltatónál
# maradnak, ezért a váltás nem érinti a régi nyugták sztornóját és PDF-jét.
BILLING_PROVIDER="billingo"
BILLING_VAT_KEY="AAM"

# Billingo (api.billingo.hu/v3). A bizonylattömböt a fiókból olvassuk ki.
BILLINGO_API_KEY=""

# Google Naptár — dolgozónkénti összekötés (Google Cloud Console → OAuth kliens).
# A REDIRECT_URI-t pontosan így kell felvenni a Google-kliensnél is.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://spellbook.colormecrazy.hu/api/google/callback"
